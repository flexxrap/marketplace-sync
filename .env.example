# --- Wildberries API ---
# The search endpoint is public and requires no key.
# Set a custom User-Agent if WB starts blocking default requests.
# WB_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36

# --- Google Sheets export (Phase 2) ---
# 1. In Google Cloud Console, create a project, enable the Sheets API,
#    create a service account, and download its JSON key.
# 2. Place the key file at google-credentials.json (it's in .gitignore).
# 3. Share the target spreadsheet with the service account email (Editor).
# GOOGLE_CREDENTIALS_FILE=google-credentials.json
# GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-from-url
# GOOGLE_WORKSHEET=MarketplaceSync
